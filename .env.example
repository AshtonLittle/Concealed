# ============================================================================
# CONCEALED MULTI-ACCOUNT SNOWFLAKE GPU FLEET CONFIGURATION (.env)
# ============================================================================
# Configure 1 to 4+ Snowflake accounts below. Each account runs 1x NVIDIA A10G
# GPU instance (GPU_NV_S) in parallel on its own disjoint data shard & specialist
# ViT surrogate focus, then merges into `trained_model/best_generator.pt`.

# --- Account 1 (SigLIP / Gemini Specialist + Shard 1/4) ---
SNOWFLAKE_ACCOUNT_1=YOUR_ACCOUNT_1
SNOWFLAKE_USER_1=YOUR_USER_1
SNOWFLAKE_PASSWORD_1=YOUR_PASSWORD_1
SNOWFLAKE_ROLE_1=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE_1=COMPUTE_WH

# --- Account 2 (CLIP / OpenAI Specialist + Shard 2/4) ---
SNOWFLAKE_ACCOUNT_2=YOUR_ACCOUNT_2
SNOWFLAKE_USER_2=YOUR_USER_2
SNOWFLAKE_PASSWORD_2=YOUR_PASSWORD_2
SNOWFLAKE_ROLE_2=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE_2=COMPUTE_WH

# --- Account 3 (DINOv2 / Dense Spatial Specialist + Shard 3/4) ---
SNOWFLAKE_ACCOUNT_3=YOUR_ACCOUNT_3
SNOWFLAKE_USER_3=YOUR_USER_3
SNOWFLAKE_PASSWORD_3=YOUR_PASSWORD_3
SNOWFLAKE_ROLE_3=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE_3=COMPUTE_WH

# --- Account 4 (Balanced Multi-Scale Anchor + Shard 4/4) ---
SNOWFLAKE_ACCOUNT_4=YOUR_ACCOUNT_4
SNOWFLAKE_USER_4=YOUR_USER_4
SNOWFLAKE_PASSWORD_4=YOUR_PASSWORD_4
SNOWFLAKE_ROLE_4=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE_4=COMPUTE_WH
